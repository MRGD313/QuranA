# Bale bot token (get it from @BotFather in ble.ir).
# Never commit the real token. Keep it only in your local .env file.
BALE_TOKEN=your-bale-bot-token-here

# ---------- Webhook deployment (optional; not needed for local polling) ----------
# Secret path segment of the webhook endpoint; use a long random string.
# WEBHOOK_SECRET=your-webhook-secret
# Public base URL of the service; on Render it is read from RENDER_EXTERNAL_URL.
# PUBLIC_BASE_URL=https://your-app.onrender.com
# PORT=8080
